# ── Required ──────────────────────────────────────────────────────────────────

# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# The numeric ID of the channel where daily problems will be posted.
# Enable Developer Mode in Discord (Settings → Advanced → Developer Mode),
# then right-click the channel and choose "Copy Channel ID".
CHANNEL_ID=123456789012345678

# ── Optional ──────────────────────────────────────────────────────────────────

# Comma-separated Discord user IDs to @mention in each daily post.
# Leave blank to post without mentions.
# Example: MEMBER_IDS=111111111111111111,222222222222222222,333333333333333333
MEMBER_IDS=
